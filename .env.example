# V1.0 public configuration and empty secret placeholders. Never put real
# secret values in this file.
# Frontend remains static; only the non-secret Worker origin/public key may be
# exposed to the browser at runtime. Secrets belong in wrangler secret or CI.

# Public API origin used by the static PWA.
WORKER_BASE_URL=https://stardew-todo-worker.stardew-todo.workers.dev

# Cloudflare identifiers used by local tooling/CI. Account ID and D1 ID are
# configuration values, not bearer credentials, but keep them environment-
# specific and do not paste API tokens here.
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=

# GitHub Actions only; set in repository Secrets, never in .env.
CLOUDFLARE_API_TOKEN=

# Web Push VAPID values. The private key and subject are Worker secrets. The
# public key can be returned by /v1/config, but may also be supplied at deploy.
VAPID_SUBJECT=mailto:replace@example.invalid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Exact comma-separated CORS origins; do not use a wildcard in production.
ALLOWED_ORIGINS=https://lvmelon.github.io,http://localhost:4173,http://localhost:8787
